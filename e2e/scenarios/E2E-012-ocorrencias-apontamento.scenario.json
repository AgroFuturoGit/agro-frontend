{
  "schema_version": 1,
  "id": "E2E-012",
  "title": "Ocorrências de campo do apontamento",
  "description": "O agricultor registra uma ocorrência (praga, com link de evidência) num apontamento seu, ela aparece no painel do apontamento e ele a exclui; o gestor abre o mesmo apontamento e vê as ocorrências sem nenhuma ação de escrita.",
  "feature_slug": "epic5-dados-sociais-ocorrencias",
  "ac_refs": [
    "AC-010"
  ],
  "priority": "P0",
  "tags": [
    "producao",
    "ocorrencias",
    "apontamento"
  ],
  "preconditions": {
    "base_url_env": "E2E_BASE_URL",
    "start_path": "/login",
    "users": [
      {
        "role": "FARMER",
        "credentials_env": {
          "email": "E2E_FARMER_EMAIL",
          "password": "E2E_FARMER_PASSWORD"
        }
      },
      {
        "role": "MANAGER",
        "credentials_env": {
          "email": "E2E_MANAGER_EMAIL",
          "password": "E2E_MANAGER_PASSWORD"
        }
      }
    ],
    "state": [
      "Backend develop rodando com as migrations aplicadas",
      "Agricultor com plano e um apontamento; caminho do detalhe do plano em E2E_PLAN_PATH; gestor da organização do agricultor em E2E_MANAGER_*",
      "Apontamento com a ocorrência 'Ocorrência Semente' (evento climático) criada pela API, para a leitura do gestor"
    ]
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "Agricultor registra uma ocorrência de praga com link de evidência e a exclui",
      "as_user": "FARMER",
      "steps": [
        {
          "action": "fill",
          "target": {
            "by": "label",
            "value": "E-mail"
          },
          "value": "${env:E2E_FARMER_EMAIL}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "#password"
          },
          "value": "${env:E2E_FARMER_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Entrar"
          }
        },
        {
          "action": "wait",
          "value": "/admin",
          "note": "aguarda o redirecionamento pós-login"
        },
        {
          "action": "goto",
          "value": "${env:E2E_PLAN_PATH}"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Ocorrências do apontamento",
            "exact": true
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Adicionar ocorrência",
            "exact": true
          }
        },
        {
          "action": "select",
          "target": {
            "by": "label",
            "value": "Tipo",
            "exact": true
          },
          "value": "PEST"
        },
        {
          "action": "fill",
          "target": {
            "by": "label",
            "value": "Descrição",
            "exact": true
          },
          "value": "Lagarta do cartucho E2E"
        },
        {
          "action": "fill",
          "target": {
            "by": "label",
            "value": "Observação climática (opcional)",
            "exact": true
          },
          "value": "Sol forte"
        },
        {
          "action": "fill",
          "target": {
            "by": "label",
            "value": "Link da evidência (opcional)",
            "exact": true
          },
          "value": "https://exemplo.test/evidencia-e2e.jpg"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Salvar",
            "exact": true
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "text",
            "value": "Lagarta do cartucho E2E"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "a[href='https://exemplo.test/evidencia-e2e.jpg'][rel='noopener noreferrer']"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Excluir ocorrência Praga",
            "exact": true
          }
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[role=alertdialog] button:has-text('Excluir')"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "text",
            "value": "Ocorrência Semente"
          }
        }
      ],
      "assertions": [
        {
          "expect": "hidden",
          "target": {
            "by": "role",
            "value": "alertdialog",
            "name": "Excluir ocorrência"
          }
        },
        {
          "expect": "hidden",
          "target": {
            "by": "text",
            "value": "Lagarta do cartucho E2E"
          }
        },
        {
          "expect": "visible",
          "target": {
            "by": "text",
            "value": "Ocorrência Semente"
          }
        }
      ]
    },
    {
      "name": "validation_error",
      "title": "Agricultor tenta salvar sem tipo e sem descrição e vê os erros por campo",
      "as_user": "FARMER",
      "steps": [
        {
          "action": "fill",
          "target": {
            "by": "label",
            "value": "E-mail"
          },
          "value": "${env:E2E_FARMER_EMAIL}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "#password"
          },
          "value": "${env:E2E_FARMER_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Entrar"
          }
        },
        {
          "action": "wait",
          "value": "/admin",
          "note": "aguarda o redirecionamento pós-login"
        },
        {
          "action": "goto",
          "value": "${env:E2E_PLAN_PATH}"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Ocorrências do apontamento",
            "exact": true
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Adicionar ocorrência",
            "exact": true
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Salvar",
            "exact": true
          }
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "text",
            "value": "O tipo de ocorrência é obrigatório"
          }
        },
        {
          "expect": "visible",
          "target": {
            "by": "text",
            "value": "A descrição é obrigatória"
          }
        }
      ]
    },
    {
      "name": "manager_readonly",
      "title": "Gestor vê as ocorrências do apontamento sem nenhuma ação de escrita",
      "as_user": "MANAGER",
      "steps": [
        {
          "action": "fill",
          "target": {
            "by": "label",
            "value": "E-mail"
          },
          "value": "${env:E2E_MANAGER_EMAIL}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "#password"
          },
          "value": "${env:E2E_MANAGER_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Entrar"
          }
        },
        {
          "action": "wait",
          "value": "/admin",
          "note": "aguarda o redirecionamento pós-login"
        },
        {
          "action": "goto",
          "value": "${env:E2E_PLAN_PATH}"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Ocorrências do apontamento",
            "exact": true
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "text",
            "value": "Ocorrência Semente"
          }
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "text",
            "value": "Ocorrência Semente"
          }
        },
        {
          "expect": "hidden",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Adicionar ocorrência",
            "exact": true
          }
        },
        {
          "expect": "hidden",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Editar ocorrência Evento climático",
            "exact": true
          }
        },
        {
          "expect": "hidden",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Excluir ocorrência Evento climático",
            "exact": true
          }
        }
      ]
    }
  ],
  "not_applicable": {
    "forbidden": "O 403 de leitura/escrita por falta de assistência é exercitado no E2E-011 (forbidden); o ownership do agricultor é regra do back, verificada por curl.",
    "empty_state": "Estado vazio coberto em execution-occurrences-sheet.test.tsx."
  }
}
